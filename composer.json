{
  "name":"emeraldhair/website",
  "type":"project",
  "description":"Emerald Hair luxury e-commerce platform",
  "require":{"php":"^8.2","laravel/framework":"^12.0","laravel/tinker":"^2.10"},
  "require-dev":{"fakerphp/faker":"^1.23","phpunit/phpunit":"^11.5"},
  "autoload":{"psr-4":{"App\\":"app/","Database\\Factories\\":"database/factories/","Database\\Seeders\\":"database/seeders/"}},
  "scripts":{"post-autoload-dump":["@php artisan package:discover --ansi"],"post-update-cmd":["@php artisan vendor:publish --tag=laravel-assets --ansi --force"],"post-root-package-install":["@php -r \"file_exists('.env') || copy('.env.example', '.env');\""],"post-create-project-cmd":["@php artisan key:generate --ansi","@php artisan migrate --graceful --ansi"]},
  "minimum-stability":"stable","prefer-stable":true
}
