APP_NAME="Emerald Hair"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development uses SQLite out of the box (no database server required).
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database/database.sqlite

# --- MySQL (e.g. XAMPP) ---
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=emerald_hair
# DB_USERNAME=root
# DB_PASSWORD=

# --- PostgreSQL (recommended for production / Render) ---
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=emerald_hair
# DB_USERNAME=postgres
# DB_PASSWORD=
# DATABASE_URL=            # Render provides this as a single connection string

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@emeraldhair.local"
MAIL_FROM_NAME="${APP_NAME}"

# Business details used by the storefront (WhatsApp checkout, contact, footer).
EMERALD_WHATSAPP=2347069133416
EMERALD_INSTAGRAM=https://instagram.com/emeraldhair
EMERALD_EMAIL=ajemeoluchi@gmail.com

# Password for the seeded administrator (admin@emeraldhair.local). Change this.
EMERALD_ADMIN_PASSWORD=ChangeMe123!

# Paystack (online payments). Leave PAYSTACK_SECRET_KEY empty to disable online
# payment and fall back to WhatsApp order confirmation.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_MERCHANT_EMAIL=
PAYSTACK_BASE_URL=https://api.paystack.co
# PAYSTACK_CALLBACK_URL=https://your-domain/payments/paystack/callback


VITE_APP_NAME="${APP_NAME}"
