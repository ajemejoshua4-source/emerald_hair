{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Serve: Laravel",
      "type": "shell",
      "command": "php artisan serve --host=127.0.0.1 --port=8000",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "Migrate + Seed",
      "type": "shell",
      "command": "php artisan migrate --seed",
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Composer Install",
      "type": "shell",
      "command": "composer install",
      "problemMatcher": []
    }
  ]
}
